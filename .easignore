# EAS mengabaikan file berdasarkan .gitignore, padahal .env dibutuhkan
# saat build agar process.env.EXPO_PUBLIC_FIREBASE_* ter-inline.
# File ini menggantikan .gitignore khusus untuk upload ke EAS:
# isinya sama, kecuali .env TIDAK diabaikan.
# Nilai di dalam .env adalah konfigurasi klien Firebase (bukan rahasia).

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
