rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==================== Helper ====================

    function isSignedIn() {
      return request.auth != null;
    }

    // Role selalu dibaca dari dokumen profil, bukan dari klaim yang bisa dipalsukan klien.
    function profilSaya() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isPraktikan() {
      return isSignedIn() && profilSaya().role == 'praktikan';
    }

    // Kompatibel mundur: dokumen lama dengan role 'asisten' diperlakukan sebagai 'asprak'
    function isAsprak() {
      return isSignedIn() && (profilSaya().role == 'asprak' || profilSaya().role == 'asisten');
    }

    function isAslab() {
      return isSignedIn() && profilSaya().role == 'aslab';
    }

    function managesCourse(courseId) {
      return isAslab()
        && courseId is string
        && courseId.size() > 0
        && profilSaya().get('managedCourseIds', []).hasAny([courseId]);
    }

    function isAsisten() {
      return isAsprak() || isAslab();
    }

    function isAssignedAsprak(targetId) {
      let assignmentPath = /databases/$(database)/documents/labAssignments/$(targetId + '_' + request.auth.uid);
      return isAsprak()
        && targetId is string
        && targetId.size() > 0
        && exists(assignmentPath)
        && get(assignmentPath).data.active == true
        && (!('uid' in get(assignmentPath).data) || get(assignmentPath).data.uid == request.auth.uid)
        && (
          (!('labId' in get(assignmentPath).data) && !('classId' in get(assignmentPath).data))
          || get(assignmentPath).data.get('labId', '') == targetId
          || get(assignmentPath).data.get('classId', '') == targetId
        );
    }

    function jadwalMulaiWib(session) {
      let tanggal = session.tanggal.split('-');
      let jam = session.jamMulai.split(':');
      return timestamp.date(int(tanggal[0]), int(tanggal[1]), int(tanggal[2]))
        + duration.value(int(jam[0]) * 60 + int(jam[1]) - 420, 'm');
    }

    function lewatToleransi(session) {
      let openedAt = session.get('openedAt', null);
      let hasSchedule = session.get('tanggal', '') is string
        && session.get('jamMulai', '') is string
        && session.get('tanggal', '').matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && session.get('jamMulai', '').matches('([01][0-9]|2[0-3]):[0-5][0-9]');
      let grace = session.get('gracePeriodMinutes', 15);
      let tolerance = duration.value(grace is number && grace >= 0 && grace <= 120 ? int(grace) : 15, 'm');
      // Kedua batas harus lewat, setara dengan max(jadwal mulai, waktu buka) + toleransi.
      return openedAt is timestamp
        && request.time > openedAt + tolerance
        && (!hasSchedule || request.time > jadwalMulaiWib(session) + tolerance);
    }

    function hanyaFieldBerubah(daftarField) {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(daftarField);
    }

    function sesi(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)).data;
    }

    // ID keanggotaan/jadwal untuk pengecekan keanggotaan kelas praktikan.
    function anggotaKelas(classId) {
      return get(/databases/$(database)/documents/classMembers/$(classId + '_' + request.auth.uid)).data;
    }

    function isAnggotaKelas(classId) {
      return isPraktikan()
        && exists(/databases/$(database)/documents/classMembers/$(classId + '_' + request.auth.uid))
        && anggotaKelas(classId).active == true
        && anggotaKelas(classId).classId == classId
        && anggotaKelas(classId).uid == request.auth.uid;
    }

    // ==================== Profil pengguna & token perangkat ====================
    // Dokumen users/{uid} ditulis P1. Registrasi mandiri selalu "praktikan".
    // Role hanya boleh diubah lewat provisioning terpercaya (Console / Admin SDK),
    // sehingga setiap perubahan role dari klien ditolak.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAsisten());

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'praktikan'
        && request.resource.data.nama is string
        && request.resource.data.nama.size() >= 2;

      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && hanyaFieldBerubah(['nama', 'nim', 'nip', 'updatedAt']);

      allow delete: if false;

      // Token perangkat push notification (Sprint 3 · SRS-07).
      // Pemilik akun dapat mendaftarkan/menghapus token miliknya;
      // asisten dapat membaca token untuk penargetan notifikasi kelas/izin.
      match /devices/{token} {
        allow read: if isSignedIn() && (request.auth.uid == uid || isAsisten());

        allow create, update: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.platform in ['android', 'ios', 'web'];

        allow delete: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // ==================== Mata kuliah (Sprint 4) ====================
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow create, update: if isAslab() && managesCourse(courseId);
      allow delete: if false;
    }

    // ==================== Data laboratorium (Sprint 3–4) ====================
    match /laboratories/{labId} {
      allow read: if isSignedIn();

      allow create: if isAslab()
        && (!('courseId' in request.resource.data) || managesCourse(request.resource.data.courseId))
        && request.resource.data.nama is string
        && request.resource.data.nama.size() > 0
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90.0
        && request.resource.data.latitude <= 90.0
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180.0
        && request.resource.data.longitude <= 180.0
        && request.resource.data.radiusMeters is number
        && request.resource.data.radiusMeters >= 10
        && request.resource.data.radiusMeters <= 500
        && (!('gracePeriodMinutes' in request.resource.data)
          || (request.resource.data.gracePeriodMinutes is number
            && request.resource.data.gracePeriodMinutes >= 0
            && request.resource.data.gracePeriodMinutes <= 120))
        && (!('lateFineAmount' in request.resource.data)
          || (request.resource.data.lateFineAmount is number
            && request.resource.data.lateFineAmount >= 0));

      allow update: if isAslab()
        && (!('courseId' in request.resource.data) || managesCourse(request.resource.data.courseId))
        && request.resource.data.nama is string
        && request.resource.data.nama.size() > 0
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90.0
        && request.resource.data.latitude <= 90.0
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180.0
        && request.resource.data.longitude <= 180.0
        && request.resource.data.radiusMeters is number
        && request.resource.data.radiusMeters >= 10
        && request.resource.data.radiusMeters <= 500
        && (!('gracePeriodMinutes' in request.resource.data)
          || (request.resource.data.gracePeriodMinutes is number
            && request.resource.data.gracePeriodMinutes >= 0
            && request.resource.data.gracePeriodMinutes <= 120))
        && (!('lateFineAmount' in request.resource.data)
          || (request.resource.data.lateFineAmount is number
            && request.resource.data.lateFineAmount >= 0));

      // Lab diarsipkan (aktif = false), tidak dihapus fisik.
      allow delete: if false;
    }

    // ==================== Distribusi Asprak ke Lab (Sprint 4) ====================
    match /labAssignments/{assignmentId} {
      allow read: if isAslab()
        || (isAsprak() && resource.data.uid == request.auth.uid);
      allow create, update: if isAslab();
      allow delete: if false;
    }

    // ==================== Data praktikum (P2 & Aslab) ====================
    // Baca: Aslab melihat semua; Asprak hanya lab yang ditugaskan; praktikan hanya kelasnya.
    match /classes/{classId} {
      allow read: if isAslab() || isAssignedAsprak(classId) || isAnggotaKelas(classId);
      allow create, update: if isAslab();
      allow delete: if false;
    }

    match /classMembers/{memberId} {
      function identitasAnggotaValid(data) {
        return data.classId is string && data.classId.size() > 0
          && data.uid is string && data.uid.size() > 0
          && memberId == data.classId + '_' + data.uid;
      }

      function dapatAktifkanAnggota(data) {
        let profil = get(/databases/$(database)/documents/users/$(data.uid)).data;
        let kelas = get(/databases/$(database)/documents/classes/$(data.classId)).data;
        return profil.role == 'praktikan' && profil.uid == data.uid
          && kelas.get('archived', false) == false
          && data.nama is string && data.nama.size() > 0
          && data.nim is string;
      }

      allow read: if isAslab()
        || isAssignedAsprak(resource.data.classId)
        || (isPraktikan() && resource.data.uid == request.auth.uid);
      allow create: if isAslab()
        && request.resource.data.keys().hasOnly(['classId', 'uid', 'nama', 'nim', 'active', 'createdAt', 'updatedAt'])
        && identitasAnggotaValid(request.resource.data)
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && dapatAktifkanAnggota(request.resource.data);
      allow update: if isAslab()
        && identitasAnggotaValid(request.resource.data)
        && request.resource.data.updatedAt == request.time
        && (
          (hanyaFieldBerubah(['nama', 'nim', 'active', 'updatedAt'])
            && request.resource.data.active == true
            && dapatAktifkanAnggota(request.resource.data))
          || (hanyaFieldBerubah(['active', 'updatedAt']) && request.resource.data.active == false)
        );
      allow delete: if false;
    }

    match /practicumInitialization/demo {
      allow get: if isAslab();
      allow create: if isAslab()
        && request.resource.data.keys().hasOnly(['initializedBy', 'initializedAt'])
        && request.resource.data.initializedBy == request.auth.uid
        && request.resource.data.initializedAt == request.time;
    }

    match /schedules/{scheduleId} {
      allow read: if isAslab()
        || isAssignedAsprak(resource.data.classId)
        || (isPraktikan() && isAnggotaKelas(resource.data.classId));
      allow create: if isAslab() || isAssignedAsprak(request.resource.data.classId);
      allow update: if isAslab()
        || (isAssignedAsprak(resource.data.classId)
          && request.resource.data.classId == resource.data.classId);
      allow delete: if false;
    }

    match /sessions/{sessionId} {
      function belumPernahDibuka() {
        return resource.data.status in ['closed', 'scheduled', 'dijadwalkan']
          && resource.data.openedAt == null
          && resource.data.closedAt == null;
      }

      function transisiSesiValid() {
        return (
          hanyaFieldBerubah(['status', 'openedAt', 'updatedAt'])
            && resource.data.status == 'closed'
            && belumPernahDibuka()
            && request.resource.data.status == 'open'
            && request.resource.data.openedAt == request.time
        ) || (
          hanyaFieldBerubah(['status', 'closedAt', 'updatedAt'])
            && resource.data.status == 'open'
            && resource.data.openedAt is timestamp
            && resource.data.openedAt <= request.time
            && resource.data.closedAt == null
            && request.resource.data.status == 'closed'
            && request.resource.data.closedAt == request.time
        );
      }

      function editSesiValid() {
        let data = request.resource.data;
        return data.topik is string && data.topik.size() > 0
          && data.ruang is string && data.ruang.size() > 0
          && (
            hanyaFieldBerubah([
              'topik', 'ruang', 'courseId', 'labId', 'labNama', 'labCoordinates',
              'radiusMeters', 'gracePeriodMinutes', 'lateFineAmount', 'updatedAt'
            ])
            || (
              resource.data.status == 'closed'
              && belumPernahDibuka()
              && hanyaFieldBerubah([
                'topik', 'ruang', 'courseId', 'labId', 'labNama', 'labCoordinates',
                'radiusMeters', 'gracePeriodMinutes', 'lateFineAmount',
                'tanggal', 'jamMulai', 'jamSelesai', 'startAt', 'endAt', 'updatedAt'
              ])
              && data.tanggal.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
              && data.jamMulai.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
              && data.jamSelesai.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
              && data.jamMulai < data.jamSelesai
              && data.startAt == data.tanggal + 'T' + data.jamMulai + ':00'
              && data.endAt == data.tanggal + 'T' + data.jamSelesai + ':00'
            )
          );
      }

      allow read: if isAslab()
        || isAssignedAsprak(resource.data.classId)
        || (isPraktikan() && isAnggotaKelas(resource.data.classId));

      allow create: if (isAslab() || isAssignedAsprak(request.resource.data.classId))
        && request.resource.data.status == 'closed'
        && request.resource.data.openedAt == null
        && request.resource.data.closedAt == null
        && request.resource.data.get('archived', false) == false;

      allow update: if (isAslab() || isAssignedAsprak(resource.data.classId))
        && resource.data.get('archived', false) == false
        && request.resource.data.updatedAt == request.time
        && (
          transisiSesiValid()
          || editSesiValid()
          || (
            hanyaFieldBerubah(['archived', 'updatedAt'])
            && request.resource.data.archived == true
            && (belumPernahDibuka()
              || (resource.data.status == 'closed'
                && resource.data.openedAt is timestamp
                && resource.data.closedAt is timestamp
                && resource.data.openedAt <= resource.data.closedAt))
          )
        );

      allow delete: if false;
    }

    // ==================== Presensi berbasis lokasi (Sprint 3–4) ====================
    // ID dokumen = UID praktikan sehingga duplikasi tidak mungkin.
    // Hanya create, hanya saat sesi "open", anggota aktif kelas, dan validasi geofence + jam server.
    match /sessions/{sessionId}/attendances/{uid} {
      function statusKeterlambatanValid(session, attendance) {
        let late = lewatToleransi(session);
        let fineAmount = session.get('lateFineAmount', 10000);
        let fineId = sessionId + '_' + uid;
        let finePath = /databases/$(database)/documents/fines/$(fineId);
        return (
          !late
          && attendance.lateStatus == 'on_time'
          && attendance.lateMinutes == 0
          && attendance.fineId == null
        ) || (
          late
          && attendance.lateStatus == 'late'
          && attendance.lateMinutes is int
          && attendance.lateMinutes > 0
          && (
            (fineAmount > 0 && attendance.fineId == fineId && existsAfter(finePath))
            || (fineAmount <= 0 && attendance.fineId == null)
          )
        );
      }

      allow read: if isSignedIn()
        && (request.auth.uid == uid || isAslab() || isAssignedAsprak(sesi(sessionId).classId));

      allow create: if isPraktikan()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.sessionId == sessionId
        && request.resource.data.classId == sesi(sessionId).classId
        && request.resource.data.status == 'hadir'
        && request.resource.data.recordedAt == request.time
        && sesi(sessionId).status == 'open'
        && sesi(sessionId).get('archived', false) == false
        && isAnggotaKelas(sesi(sessionId).classId)
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90.0
        && request.resource.data.latitude <= 90.0
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180.0
        && request.resource.data.longitude <= 180.0
        && request.resource.data.distanceMeters is number
        && request.resource.data.distanceMeters >= 0
        && request.resource.data.distanceMeters <= sesi(sessionId).get('radiusMeters', 30)
        && request.resource.data.geofenceStatus == 'in_radius'
        && statusKeterlambatanValid(sesi(sessionId), request.resource.data);

      // Presensi tidak boleh diubah atau dihapus dari klien.
      allow update, delete: if false;
    }

    // ==================== Pengajuan izin (P3 & Scoping Asprak) ====================
    // Field keputusan (status/reviewedBy/reviewedAt/reviewNote) hanya untuk Aslab/Asprak terkait.
    // Field ai ditulis pemohon sebagai hasil yang dilaporkan klien (informasi
    // pendukung), terpisah dari keputusan dan tidak pernah mengubah status otomatis.
    // ID deterministik {sessionId}_{uid} mencegah duplikasi pengajuan untuk sesi yang sama.
    match /leaveRequests/{requestId} {
      // Transaksi pembuatan izin mengecek keberadaan ID deterministik sebelum menulis.
      allow get: if resource == null
        && isPraktikan()
        && request.auth.uid.matches('^[A-Za-z0-9_-]+$')
        && requestId.matches('^.+_' + request.auth.uid + '$');

      allow read: if isSignedIn()
        && (
          resource.data.uid == request.auth.uid
          || isAslab()
          || isAssignedAsprak(resource.data.classId)
        );

      allow create: if isPraktikan()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() > 0
        && request.resource.data.classId is string
        && request.resource.data.classId.size() > 0
        && requestId == request.resource.data.sessionId + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId))
        && sesi(request.resource.data.sessionId).get('archived', false) == false
        && request.resource.data.classId == sesi(request.resource.data.sessionId).classId
        && isAnggotaKelas(request.resource.data.classId)
        && request.resource.data.status == 'pending'
        && request.resource.data.alasan is string
        && request.resource.data.alasan.size() >= 1
        && request.resource.data.alasan.size() <= 1000
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Pemohon hanya boleh mengisi hasil klasifikasi AI pada pengajuannya sendiri,
      // tanpa menyentuh keputusan asisten maupun identitas pengajuan.
      // Hasil ini diperlakukan sebagai "dilaporkan klien" (informasi pendukung).
      allow update: if isPraktikan()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == resource.data.status
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.alasan == resource.data.alasan
        && request.resource.data.updatedAt == request.time
        && hanyaFieldBerubah(['ai', 'updatedAt']);

      allow update: if (isAslab() || isAssignedAsprak(resource.data.classId))
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.alasan == resource.data.alasan
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.updatedAt == request.time
        && hanyaFieldBerubah(['status', 'reviewedBy', 'reviewedAt', 'reviewNote', 'updatedAt']);

      allow delete: if false;
    }

    // ==================== Tagihan denda keterlambatan (Sprint 4 · SRS-04/08) ====================
    // Dibuat 1x saat praktikan presensi terlambat (ID = {sessionId}_{uid}).
    // Status 'paid' TIDAK BOLEH ditulis dari klien; hanya Backend Admin SDK yang boleh melunasi.
    match /fines/{fineId} {
      function dendaSesuaiPresensi(fine) {
        let session = sesi(fine.sessionId);
        let uid = request.auth.uid;
        let attendancePath = /databases/$(database)/documents/sessions/$(fine.sessionId)/attendances/$(uid);
        let attendance = getAfter(attendancePath).data;
        let labId = session.get('labId', null);
        let courseId = session.get('courseId', null);
        let praktikumId = session.get('praktikumId', null);
        return fine.attendanceId == 'sessions/' + fine.sessionId + '/attendances/' + uid
          && attendance.uid == uid
          && attendance.sessionId == fine.sessionId
          && attendance.classId == session.classId
          && attendance.status == 'hadir'
          && attendance.lateStatus == 'late'
          && attendance.recordedAt == request.time
          && !exists(attendancePath)
          && attendance.fineId == fineId
          && (!('classId' in fine) || fine.classId == session.classId)
          && fine.labId == (labId is string && labId != '' ? labId : session.classId)
          && fine.courseId == (courseId is string && courseId != '' ? courseId
            : praktikumId is string && praktikumId != '' ? praktikumId : 'praktikum-ppk')
          && fine.lateMinutes is int
          && fine.lateMinutes > 0
          && fine.lateMinutes == attendance.lateMinutes
          && fine.amount is int
          && fine.amount > 0
          && fine.amount == session.get('lateFineAmount', 10000)
          && lewatToleransi(session);
      }

      // Transaksi presensi mengecek ID denda sebelum dokumennya ada.
      allow get: if resource == null
        && isPraktikan()
        && request.auth.uid.matches('^[A-Za-z0-9_-]+$')
        && fineId.matches('^.+_' + request.auth.uid + '$');

      allow read: if isAslab()
        || (isPraktikan() && resource.data.uid == request.auth.uid)
        || (isAsprak() && (
          isAssignedAsprak(resource.data.get('classId', resource.data.labId))
          || isAssignedAsprak(resource.data.labId)
        ));

      allow create: if isPraktikan()
        && request.resource.data.uid == request.auth.uid
        && fineId == request.resource.data.sessionId + '_' + request.auth.uid
        && request.resource.data.id == fineId
        && request.resource.data.status == 'unpaid'
        && dendaSesuaiPresensi(request.resource.data);

      // Asprak/Aslab hanya boleh membebaskan tagihan ('waived') jika izin disetujui, tidak pernah 'paid'
      allow update: if (
          isAslab()
          || isAssignedAsprak(resource.data.get('classId', resource.data.labId))
          || isAssignedAsprak(resource.data.labId)
        )
        && resource.data.status == 'unpaid'
        && request.resource.data.status == 'waived'
        && hanyaFieldBerubah(['status', 'updatedAt']);

      allow delete: if false;
    }

    // ==================== Transaksi pembayaran Midtrans (Sprint 4 · SRS-05/08) ====================
    // Seluruh penulisan (pending, success, failed) dilakukan oleh Backend Admin SDK.
    match /payments/{orderId} {
      allow read: if isAslab()
        || (isPraktikan() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // ==================== Log audit notifikasi (Sprint 3 · SRS-06) ====================
    match /notifications/{notificationId} {
      allow read: if isSignedIn()
        && (resource.data.recipientUid == request.auth.uid || isAsisten());

      allow create: if isAsisten()
        && request.resource.data.recipientUid is string
        && request.resource.data.recipientUid.size() > 0
        && request.resource.data.type in ['session_opened', 'schedule_changed', 'leave_decided']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.status in ['sent', 'delivered', 'failed'];

      allow update, delete: if false;
    }
  }
}
